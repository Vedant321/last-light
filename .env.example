# Server only. Copy to .env.local and fill locally. Never use VITE_ for secrets.
# Set a model enabled for YOUR Gemini account. Use scripts/check_providers.py to list models.
GEMINI_API_KEY=
GEMINI_MODEL=
# auto uses Gemini when both settings above exist; offline disables provider calls.
DIALOGUE_MODE=auto

# Optional. Gemini text and all mission controls work without ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_VOICE_ECHO=
ELEVENLABS_VOICE_ENGINEER=
ELEVENLABS_VOICE_MEDIC=
ELEVENLABS_VOICE_PILOT=

PORT=3001
# Optional: DATABASE_PATH=.data/last-light.sqlite3
# For HTTPS hosting set SECURE_COOKIES=true and ALLOWED_ORIGINS to the exact public origin.
# ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3001
